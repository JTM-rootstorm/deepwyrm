#!/bin/sh
set -eu

usage() {
    cat <<'EOF'
Usage: tools/pinned-cargo <lane> <cargo-args...>

Lanes:
  target  Accepted Wyrmroot 1.97.1/a92dc7f7 product and freestanding builds.
  host    Pinned stable 1.98.1 tests, Clippy, rustdoc, formatting, and xtask.

Each lane owns a pinned target directory beneath deepwyrm/.tmp so repeated
commands reuse compatible artifacts. DEEPWYRM_PINNED_TARGET_DIR may select an
absolute isolated directory beneath /tmp or deepwyrm/.tmp for concurrent/test
lanes. The canonical deepwyrm/target directory is intentionally rejected.
CARGO_HOME is selected from the lane identity and must not be supplied by the
caller.

In a coordinator-owned .worktrees/deepwyrm/<lane> worktree, the canonical
OS-Project root supplies the accepted immutable toolchain and offline-v1 Cargo
home. The lane still owns an isolated target directory and must share the
canonical deepwyrm Git directory.
EOF
}

fail() {
    printf 'pinned-cargo: %s\n' "$*" >&2
    exit 2
}

config_value() {
    config_path=$1
    config_key=$2
    awk -F ' = ' -v key="$config_key" '
        $1 == key {
            value = $2
            sub(/^"/, "", value)
            sub(/"$/, "", value)
            print value
            found = 1
        }
        END { if (!found) exit 1 }
    ' "$config_path" || fail "$config_path omits $config_key"
}

verify_file() {
    file_path=$1
    expected_sha=$2
    file_label=$3
    [ -f "$file_path" ] || fail "$file_label is not a regular file: $file_path"
    actual_sha=$(sha256sum -- "$file_path" | awk '{ print $1 }')
    [ "$actual_sha" = "$expected_sha" ] || fail "$file_label hash mismatch: $file_path"
}

contains_feature() {
    feature_list=$1
    wanted=$2
    printf '%s\n' "$feature_list" | awk -v wanted="$wanted" '
        BEGIN { FS = "[[:space:],]+" }
        {
            for (field = 1; field <= NF; field++) {
                if ($field == wanted) found = 1
            }
        }
        END { exit found ? 0 : 1 }
    '
}

require_upper_hex_u64() {
    value_name=$1
    value=$2
    [ "${#value}" -eq 16 ] || fail "$value_name must be exactly 16 uppercase hexadecimal digits"
    case "$value" in
        *[!0-9A-F]*) fail "$value_name must be exactly 16 uppercase hexadecimal digits" ;;
        0000000000000000) fail "$value_name must be nonzero" ;;
    esac
}

[ "$#" -ge 1 ] || {
    usage >&2
    exit 2
}

case "$1" in
    -h|--help|help)
        usage
        exit 0
        ;;
    host|target)
        lane=$1
        shift
        ;;
    *)
        usage >&2
        fail "unknown lane: $1"
        ;;
esac
[ "$#" -ge 1 ] || fail "missing Cargo arguments"

[ -z "${CARGO_HOME:-}" ] || fail "CARGO_HOME is lane-owned; do not supply it"
[ -z "${DEEPWYRM_GUEST_TEST_ID:-}" ] || \
    fail "DEEPWYRM_GUEST_TEST_ID is build-owned; select a named guest test instead"

test_support=false
safe_host_test_support=false
safe_host_targets=false
expect_features=false
for argument in "$@"; do
    case "$argument" in
        wyr1_primordial_selector_artifacts_fit_the_linked_boot_stack)
            fail "the accepted primordial stack gate requires tools/accepted-primordial-stack-gate"
            ;;
    esac
    if [ "$expect_features" = true ]; then
        contains_feature "$argument" test-support && test_support=true
        expect_features=false
        continue
    fi
    case "$argument" in
        --features)
            expect_features=true
            ;;
        --features=*)
            features=${argument#--features=}
            contains_feature "$features" test-support && test_support=true
            ;;
        --all-features)
            test_support=true
            ;;
        --lib)
            safe_host_test_support=true
            safe_host_targets=true
            ;;
        --tests|--test|--test=*|--doc)
            safe_host_targets=true
            ;;
    esac
done
[ "$expect_features" = false ] || fail "--features requires an explicit feature list"

if [ "$lane" = host ]; then
    for argument in "$@"; do
        case "$argument" in
            --manifest-path|--manifest-path=*|--config|--config=*)
                fail "host lane rejects manifest/config redirection"
                ;;
            --all-features|--all-targets|--bin|--bin=*|--bins|--example|--example=*|--examples|*native-*)
                fail "host lane rejects freestanding/native binary admission; use the target lane"
                ;;
            --target|--target=x86_64-unknown-wyrmroot|--target=x86_64-unknown-none|x86_64-unknown-wyrmroot|x86_64-unknown-none)
                fail "host lane rejects Wyrmroot/freestanding target selection; use the target lane"
                ;;
            --target=*)
                [ "$argument" = "--target=x86_64-unknown-linux-gnu" ] || \
                    fail "host lane rejects non-host target selection; use the target lane"
                ;;
        esac
    done
    if [ "$test_support" = false ]; then
        case "$1" in
            build|check|clippy|rustdoc)
                [ "$safe_host_targets" = true ] || \
                    fail "host lane rejects implicit $1 targets; select --lib, --tests, --test, or --doc"
                ;;
        esac
    fi
fi

selector=${DEEPWYRM_GUEST_TEST_SELECTOR:-}
if [ "$test_support" = true ] && [ -z "$selector" ]; then
    fail "test-support requires DEEPWYRM_GUEST_TEST_SELECTOR before Cargo admission"
fi
if [ "$test_support" = false ] && [ -n "$selector" ]; then
    fail "DEEPWYRM_GUEST_TEST_SELECTOR requires explicit test-support admission"
fi
if [ "$lane" = host ] && [ "$test_support" = true ]; then
    [ "$1" = test ] && [ "$safe_host_test_support" = true ] || \
        fail "host test-support is restricted to an explicit Cargo test --lib gate"
fi
if [ "$selector" = normal-preemption-up ]; then
    dw1b_nonce=${DEEPWYRM_DW1B_EVIDENCE_NONCE:-}
    dw1b_digest=${DEEPWYRM_DW1B_CHALLENGE_DIGEST:-}
    dw1b_pages=${DEEPWYRM_DW1B_BOOTFS_MAX_PAGES:-}
    require_upper_hex_u64 DEEPWYRM_DW1B_EVIDENCE_NONCE "$dw1b_nonce"
    require_upper_hex_u64 DEEPWYRM_DW1B_CHALLENGE_DIGEST "$dw1b_digest"
    case "$dw1b_pages" in
        ''|0|0*|*[!0-9]*) fail "DEEPWYRM_DW1B_BOOTFS_MAX_PAGES must be canonical decimal in 1..=8192" ;;
    esac
    [ "$dw1b_pages" -le 8192 ] || fail "DEEPWYRM_DW1B_BOOTFS_MAX_PAGES must be canonical decimal in 1..=8192"
fi
if [ "$selector" = bootstrap-registry-launch ]; then
    wyr1b_nonce=${DEEPWYRM_WYR1B_EVIDENCE_NONCE:-}
    wyr1b_pages=${DEEPWYRM_WYR1B_BOOTFS_MAX_PAGES:-}
    require_upper_hex_u64 DEEPWYRM_WYR1B_EVIDENCE_NONCE "$wyr1b_nonce"
    case "$wyr1b_pages" in
        ''|0|0*|*[!0-9]*) fail "DEEPWYRM_WYR1B_BOOTFS_MAX_PAGES must be canonical decimal in 1..=8192" ;;
    esac
    [ "$wyr1b_pages" -le 8192 ] || fail "DEEPWYRM_WYR1B_BOOTFS_MAX_PAGES must be canonical decimal in 1..=8192"
fi
if [ "$selector" = normal-preemption-smp ]; then
    dw1c_nonce=${DEEPWYRM_DW1C_EVIDENCE_NONCE:-}
    dw1c_digest=${DEEPWYRM_DW1C_PROGRESS_DIGEST:-}
    dw1c_pages=${DEEPWYRM_DW1C_BOOTFS_MAX_PAGES:-}
    require_upper_hex_u64 DEEPWYRM_DW1C_EVIDENCE_NONCE "$dw1c_nonce"
    require_upper_hex_u64 DEEPWYRM_DW1C_PROGRESS_DIGEST "$dw1c_digest"
    case "$dw1c_pages" in
        ''|0|0*|*[!0-9]*) fail "DEEPWYRM_DW1C_BOOTFS_MAX_PAGES must be canonical decimal in 1..=8192" ;;
    esac
    [ "$dw1c_pages" -le 8192 ] || fail "DEEPWYRM_DW1C_BOOTFS_MAX_PAGES must be canonical decimal in 1..=8192"
fi
if [ "$selector" = dynamic-launch-saturation ]; then
    r1_nonce=${DEEPWYRM_R1_EVIDENCE_NONCE:-}
    r1_pages=${DEEPWYRM_R1_BOOTFS_MAX_PAGES:-}
    require_upper_hex_u64 DEEPWYRM_R1_EVIDENCE_NONCE "$r1_nonce"
    case "$r1_pages" in
        ''|0|0*|*[!0-9]*) fail "DEEPWYRM_R1_BOOTFS_MAX_PAGES must be canonical decimal in 1..=8192" ;;
    esac
    [ "$r1_pages" -le 8192 ] || fail "DEEPWYRM_R1_BOOTFS_MAX_PAGES must be canonical decimal in 1..=8192"
fi

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
workspace=$(CDPATH='' cd -- "$script_dir/.." && pwd -P)
project_root=$(CDPATH='' cd -- "$workspace/.." && pwd -P)
workspace_parent=$(basename -- "$(dirname -- "$workspace")")
workspace_grandparent=$(basename -- "$(dirname -- "$(dirname -- "$workspace")")")
if [ "$workspace_parent" = "deepwyrm" ] && [ "$workspace_grandparent" = ".worktrees" ]; then
    lane_project_root=$(CDPATH='' cd -- "$workspace/../../.." && pwd -P)
    canonical_git_dir="$lane_project_root/deepwyrm/.git"
    [ -d "$canonical_git_dir" ] && [ ! -L "$canonical_git_dir" ] || \
        fail "lane layout has no canonical deepwyrm git directory"
    common_git_dir=$(git -C "$workspace" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || \
        fail "lane worktree does not expose a common git directory"
    [ "$common_git_dir" = "$canonical_git_dir" ] || \
        fail "lane worktree is not registered to canonical deepwyrm"
    project_root=$lane_project_root
fi

if [ "$lane" = host ]; then
    identity="$workspace/tooling/host-rust-toolchain.toml"
else
    identity="$workspace/tooling/rust-toolchain.toml"
fi

target_dir=${DEEPWYRM_PINNED_TARGET_DIR:-}
[ -n "$target_dir" ] || target_dir="$workspace/$(config_value "$identity" target_dir)"
case "$target_dir" in
    /tmp/*|"$workspace"/.tmp/*) ;;
    *) fail "target directory must be beneath /tmp or $workspace/.tmp" ;;
esac
normalized_target=$(realpath -m -- "$target_dir")
[ "$normalized_target" = "$target_dir" ] || fail "target directory must already be normalized"
[ "$normalized_target" != "$workspace/target" ] || fail "canonical target/ is forbidden"

unset RUSTUP_TOOLCHAIN RUSTC_BOOTSTRAP RUSTC_WRAPPER RUSTC_WORKSPACE_WRAPPER
unset CARGO_BUILD_RUSTC CARGO_BUILD_RUSTDOC CARGO_BUILD_RUSTC_WRAPPER
unset CARGO_BUILD_RUSTC_WORKSPACE_WRAPPER CARGO_BUILD_RUSTFLAGS RUSTFLAGS
unset CARGO_BUILD_TARGET CARGO_ENCODED_RUSTFLAGS RUSTDOCFLAGS CARGO_TARGET_DIR
unset LD_LIBRARY_PATH LD_PRELOAD

if [ "$lane" = host ]; then
    [ "$(config_value "$identity" schema)" = "deepwyrm-host-rust-toolchain-identity-v1" ] || \
        fail "unexpected host toolchain identity schema"
    cargo=$(config_value "$identity" cargo_binary)
    rustc=$(config_value "$identity" rustc_binary)
    rustdoc=$(config_value "$identity" rustdoc_binary)
    rustfmt=$(config_value "$identity" rustfmt_binary)
    tool_bin=$(config_value "$identity" tool_bin_directory)
    clang=$(config_value "$identity" clang_binary)
    verify_file "$cargo" "$(config_value "$identity" cargo_sha256)" "host Cargo"
    verify_file "$rustc" "$(config_value "$identity" rustc_sha256)" "host rustc"
    verify_file "$rustdoc" "$(config_value "$identity" rustdoc_sha256)" "host rustdoc"
    verify_file "$rustfmt" "$(config_value "$identity" rustfmt_sha256)" "host rustfmt"
    verify_file "$(config_value "$identity" cargo_fmt_binary)" \
        "$(config_value "$identity" cargo_fmt_sha256)" "host cargo-fmt"
    verify_file "$(config_value "$identity" cargo_clippy_binary)" \
        "$(config_value "$identity" cargo_clippy_sha256)" "host cargo-clippy"
    verify_file "$(config_value "$identity" clippy_driver_binary)" \
        "$(config_value "$identity" clippy_driver_sha256)" "host clippy-driver"
    verify_file "$(config_value "$identity" rust_analyzer_binary)" \
        "$(config_value "$identity" rust_analyzer_sha256)" "host rust-analyzer"
    rust_src_root=$(config_value "$identity" rust_src_root)
    [ -d "$rust_src_root" ] || fail "host rust-src root is not a directory: $rust_src_root"
    verify_file "$(config_value "$identity" rust_src_std_entry)" \
        "$(config_value "$identity" rust_src_std_entry_sha256)" "host rust-src std entry"
    verify_file "$(config_value "$identity" rust_src_core_entry)" \
        "$(config_value "$identity" rust_src_core_entry_sha256)" "host rust-src core entry"
    verify_file "$clang" "$(config_value "$identity" clang_sha256)" "host Clang"
    export RUSTDOC="$rustdoc"
    export RUSTFMT="$rustfmt"
    export PATH="$tool_bin:$PATH"
else
    [ "$(config_value "$identity" schema)" = "deepwyrm-rust-toolchain-identity-v1" ] || \
        fail "unexpected accepted toolchain identity schema"
    artifact_root=$(config_value "$identity" artifact_root)
    toolchain_root=$(config_value "$identity" toolchain_root)
    case "$artifact_root/$toolchain_root" in
        *..*) fail "accepted toolchain identity contains traversal" ;;
    esac
    accepted_root="$project_root/$artifact_root/$toolchain_root"
    cargo="$accepted_root/$(config_value "$identity" cargo_binary)"
    rustc="$accepted_root/$(config_value "$identity" rustc_binary)"
    rust_lld="$accepted_root/$(config_value "$identity" rust_lld_binary)"
    host_identity="$workspace/tooling/host-rust-toolchain.toml"
    clang=$(config_value "$host_identity" clang_binary)
    verify_file "$cargo" "$(config_value "$identity" cargo_sha256)" "accepted Cargo"
    verify_file "$rustc" "$(config_value "$identity" rustc_sha256)" "accepted rustc"
    verify_file "$rust_lld" "$(config_value "$identity" rust_lld_sha256)" "accepted rust-lld"
    verify_file "$accepted_root/$(config_value "$identity" rustc_driver_internal_library)" \
        "$(config_value "$identity" rustc_driver_internal_library_sha256)" \
        "accepted rustc driver"
    verify_file "$accepted_root/$(config_value "$identity" llvm_internal_library)" \
        "$(config_value "$identity" llvm_internal_library_sha256)" \
        "accepted LLVM library"
    verify_file "$clang" "$(config_value "$host_identity" clang_sha256)" "host Clang"
    export DEEPWYRM_ACCEPTED_RUST_LLD="$rust_lld"
fi

cargo_home_relative=$(config_value "$identity" cargo_home)
case "$cargo_home_relative" in
    /*|*..*) fail "lane Cargo home must be a non-traversing project-relative path" ;;
esac
cargo_home=$(realpath -m -- "$project_root/$cargo_home_relative")
case "$cargo_home" in
    "$project_root"/.tmp/*) ;;
    *) fail "lane Cargo home must resolve beneath $project_root/.tmp" ;;
esac
[ -d "$cargo_home" ] && [ ! -L "$cargo_home" ] || \
    fail "lane Cargo home is not a project-local non-symlink directory: $cargo_home"
export CARGO_HOME="$cargo_home"

mkdir -p -- "$normalized_target"
target_marker="$normalized_target/.deepwyrm-pinned-cargo-v1"
lane_identity="lane=$lane
cargo_sha256=$(config_value "$identity" cargo_sha256)
rustc_sha256=$(config_value "$identity" rustc_sha256)"
if [ -e "$target_marker" ]; then
    [ -f "$target_marker" ] && [ ! -L "$target_marker" ] || \
        fail "target identity marker is not a regular non-symlink file"
    [ "$(cat -- "$target_marker")" = "$lane_identity" ] || \
        fail "target directory belongs to another pinned Cargo lane or toolchain"
else
    if find "$normalized_target" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
        fail "target directory is nonempty but has no pinned Cargo identity marker"
    fi
    printf '%s\n' "$lane_identity" >"$target_marker"
fi

export CARGO_TARGET_DIR="$normalized_target"
export CARGO_INCREMENTAL=0
export CARGO_NET_OFFLINE=true
export RUSTC="$rustc"
export DEEPWYRM_CLANG="$clang"

"$cargo" metadata --locked --offline --format-version=1 >/dev/null || \
    fail "lane Cargo home cannot resolve the locked offline dependency graph"

exec "$cargo" "$@"
